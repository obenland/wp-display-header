{
	"name": "wp-display-header",
	"version": "7.0.0",
	"private": true,
	"description": "Specify a header image per post and per taxonomy/author archive.",
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@wordpress/env": "^11.14.0",
		"@wordpress/scripts": "^34.2.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"format": "wp-scripts format",
		"start": "wp-env start",
		"stop": "wp-env stop",
		"destroy": "wp-env destroy",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-display-header vendor/bin/phpunit"
	}
}
